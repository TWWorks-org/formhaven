APP_NAME=FormHaven

# self_hosted (default): a private form backend with no billing, trial, marketing site or operator
# identity. hosted: the paid service at formhaven.net (config/formhaven.php, app/Support/Mode.php).
FORMHAVEN_MODE=self_hosted
# Self-hosted: the first account can always be made; after that only when this is true.
ALLOW_REGISTRATION=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Daily mail budgets per UTC day (config/mail.php, app/Support/MailBudget.php). Set them so that
# together they stay well under your mail provider's daily quota.
# Submission emails across all forms, and per form (a held email waits for Send again):
MAIL_BUDGET_NOTIFICATIONS=70
MAIL_BUDGET_PER_FORM=25
# Monday summaries plus recipients' weekly counts (the rest go on a later run):
MAIL_BUDGET_SUMMARIES=40
# Abuse-report mail, 2 per report (our copy first, then the receipt):
MAIL_BUDGET_ABUSE_REPORTS=6
# "A limit was reached" notices to form owners and to OWNER_EMAILS:
MAIL_BUDGET_NOTICES=6
# Account mail (confirmation, reset, email-change notice, deletion link): accounts that never
# confirmed their address, then accounts that did (signups cannot spend the second):
MAIL_BUDGET_SIGNUP=10
MAIL_BUDGET_ACCOUNT=20

# Proxies that may tell the app the visitor's IP (config/app.php). Leave empty when nothing sits in
# front of PHP. "*" only behind a proxy that drops X-Forwarded-For from anyone it does not trust.
TRUSTED_PROXIES=

# Days a setup key from POST /api/v1/start works after the form is activated (config/sanctum.php).
SETUP_KEY_DAYS=30

# Webhooks may not point at this server: APP_URL's host, the addresses it resolves to, and these
# IPs or CIDRs (comma-separated). Behind a proxy such as Cloudflare, APP_URL resolves to shared proxy
# addresses: set WEBHOOK_BLOCK_APP_URL_IPS=false and list the server's own IPs below instead.
WEBHOOK_BLOCK_APP_URL_IPS=true
WEBHOOK_BLOCKED_IPS=

# OAuth consent screen: redirect hosts of known MCP clients; others see a warning (config/services.php).
OAUTH_KNOWN_REDIRECT_HOSTS=claude.ai

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# FormHaven per-form price (Stripe price IDs in EUR, see config/billing.php)
# Monthly and yearly are tiered prices (graduated): units 1 to 10 at EUR 1 a month / EUR 10 a year, every unit from 11 at EUR 0.50 / EUR 5. Extra: one-off EUR 0.50 per 1,000 submissions.
STRIPE_PRICE_FORM_MONTHLY=
STRIPE_PRICE_FORM_YEARLY=
STRIPE_PRICE_EXTRA_SUBMISSIONS=
STRIPE_AUTOMATIC_TAX=false

# Who runs this install (footer, legal pages and the privacy text each form generates). No defaults:
# empty means the copy names no company or country. BTW number: Stripe invoices only.
LEGAL_ENTITY=
LEGAL_KVK=
LEGAL_ADDRESS=
LEGAL_EMAIL=
# Where the operator is established, per language (NL and DE fall back to EN).
LEGAL_COUNTRY_EN=
LEGAL_COUNTRY_NL=
LEGAL_COUNTRY_DE=
# Where submissions are stored, "Place, Country". The country after the comma drives "stored in ..." copy.
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_PLACE_EN=
LEGAL_HOSTING_PLACE_NL=
LEGAL_HOSTING_PLACE_DE=
# The company that sends the emails, as named in the privacy text.
LEGAL_MAILER=
# Support inbox on public pages, in security.txt and in delivery advice (empty: MAIL_FROM_ADDRESS).
SUPPORT_EMAIL=

# "Continue with Google" (empty = button hidden). Redirect URI: APP_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Self-hosted Umami analytics (config/services.php). Empty website id: no tracker, no server events.
UMAMI_WEBSITE_ID=
# The tracker script URL the browser loads.
UMAMI_SCRIPT_URL=
# Where the server posts signup events (the Umami collect endpoint).
UMAMI_COLLECT_URL=

# IndexNow key, served at /<key>.txt (empty: no key file). Generate one with php artisan indexnow:submit.
INDEXNOW_KEY=
